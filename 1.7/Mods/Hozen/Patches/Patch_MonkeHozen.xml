<?xml version="1.0" encoding="utf-8"?>
<!-- Hozen Xenotype (Sov.mhmmmmonke) is active: the two monkey xenotypes trade genes. -->
<Patch>

  <!-- Monke: poor shooting becomes the Hozen's easily distracted. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/XenotypeDef[defName="Monke"]/genes/li[.="AptitudePoor_Shooting"]</xpath>
    <value>
      <li>GS_distracted</li>
    </value>
  </Operation>

  <!-- Monke: smooth tail becomes the Hozen's long tail. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/XenotypeDef[defName="Monke"]/genes/li[.="Tail_Smooth"]</xpath>
    <value>
      <li>Tail_Monke</li>
    </value>
  </Operation>

  <!-- Long tail drawn 0.14 higher so its base sits where vanilla's smooth tail meets the body
       (measured: vanilla base z -0.30, Hozen art base z -0.33 to -0.45, avg -0.38; 0.14 chosen in-game: variant B needs ~0.15, the rest sit slightly high). Hozen's def
       declares an empty dataWest, so west does not mirror east and needs its own offset. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Tail_Monke"]/renderNodeProperties/li/drawData/dataNorth</xpath>
    <value>
      <dataNorth>
        <offset>(0, 0, 0.14)</offset>
        <layer>90</layer>
      </dataNorth>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Tail_Monke"]/renderNodeProperties/li/drawData/dataSouth</xpath>
    <value>
      <dataSouth>
        <offset>(0, 0, 0.14)</offset>
      </dataSouth>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Tail_Monke"]/renderNodeProperties/li/drawData/dataEast</xpath>
    <value>
      <dataEast>
        <offset>(0, 0, 0.14)</offset>
      </dataEast>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Tail_Monke"]/renderNodeProperties/li/drawData/dataWest</xpath>
    <value>
      <dataWest>
        <offset>(0, 0, 0.14)</offset>
      </dataWest>
    </value>
  </Operation>

  <!-- Monke: Alpha Genes' rowdy becomes the Hozen's unruly. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/XenotypeDef[defName="Monke"]/genes/li[.="AG_Rowdy"]</xpath>
    <value>
      <li>GS_Unruly</li>
    </value>
  </Operation>

  <!-- Prehensile feet toned down to make up for the long tail's manipulation bonus. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Prehensile_Feet"]/biostatMet</xpath>
    <value>
      <biostatMet>-3</biostatMet>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Prehensile_Feet"]/capMods/li[capacity="Manipulation"]/offset</xpath>
    <value>
      <offset>0.4</offset>
    </value>
  </Operation>

  <!-- Hozen join the Monke outlander faction. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/FactionDef[defName="MonkeOutlanderRough"]/xenotypeSet/xenotypeChances</xpath>
    <value>
      <GS_Hozen>0.25</GS_Hozen>
    </value>
  </Operation>

  <!-- Hozen: with Alpha Genes also active, high survival instinct and naked speed. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/XenotypeDef[defName="GS_Hozen"]/genes</xpath>
    <value>
      <li MayRequire="sarg.alphagenes">AG_SurvivalInstinct_High</li>
      <li MayRequire="sarg.alphagenes">NakedSpeed</li>
    </value>
  </Operation>

</Patch>
